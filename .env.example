# Provisioned separately for development/preview and production through Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
# Optional explicit origin; otherwise inferred from the Vercel environment.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Server secrets only; never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
FAL_KEY=
# Optional fal key with the BILLING preset for verified billing receipts.
FAL_BILLING_KEY=
BLOB_READ_WRITE_TOKEN=
# Optional local storage guard in bytes; default 1 GB, with 64 MiB reserved for writes.
# This is not the provider's plan quota. Set only after checking its plan and budget.
# BLOB_STORAGE_LIMIT_BYTES=1000000000
# Protects cron endpoints. Daily preparation at 12:00 UTC creates a text draft.
# The legacy publish endpoint only recovers discovery; publication is manual.
# Keep automation disabled in a fresh development environment.
CRON_SECRET=
AI_RECIPE_MODEL=gpt-6-astra
AI_IMAGE_MODEL=openai/gpt-image-2.5/sunburst/text-to-image
# Production Vercel is indexable automatically; preview/development remain noindex.
# Use this only for a self-hosted production deployment.
SEO_INDEXING_ENABLED=false
# IndexNow ownership key (8–128 letters/digits/hyphens), server-only config.
INDEXNOW_KEY=
# Optional ownership verification values, from the respective webmaster panels.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Generation has no financial caps or reservations. Legacy AI_*_LIMIT_USD
# variables are ignored. Actual costs are recorded after confirmed billing.

# Optional, private renewable public catalogue fallback (24h maximum age).
# Enable after deploying every publication writer with the withdrawal fence.
PUBLIC_RECIPE_SNAPSHOT_ENABLED=false
